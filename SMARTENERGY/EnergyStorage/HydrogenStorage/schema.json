{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$schemaVersion": "0.0.1",
    "$id": "https://smart-data-models.github.io/dataModel.EnergyStorage/HydrogenStorage/schema.json",
    "title": "Hydrogen storage data model",
    "description": "A generic tank used for storing compressed hydrogen gas at high pressure",
    "modelTags": "",
    "derivedFrom": "",
    "required": [
        "id",
        "type"
    ],
    "license": "https://smart-data-models.github.io/dataModel.EnergyStorage/HydrogenStorage/LICENSE.md",
    "type": "object",
    "properties": {
        "id": {
            "type": "string",
